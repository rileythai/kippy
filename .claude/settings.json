{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git -C *)",
      "Bash(git submodule *)",
      "Bash(ls *)",
      "Bash(uv *)",
      "Bash(meson *)",
      "Bash(ninja *)",
      "Bash(make *)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:docs.python.org)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Read(.env*)",
      "Edit(.env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/session-start"
          }
        ]
      }
    ]
  }
}

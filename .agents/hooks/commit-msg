#!/bin/sh
# git commit-msg hook from the bootstrapper skill. fails a commit whose message credits Claude as a co-author:
# commits are authored by the user alone.
if grep -qiE '^co-authored[- ]by:?.*(claude|anthropic)' "$1"; then
    echo "commit-msg: the message credits Claude as a co-author. remove that trailer, then commit again." >&2
    exit 1
fi
